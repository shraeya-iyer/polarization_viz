# Reddit OAuth app credentials (register a "web app" at https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REDIRECT_URI=http://localhost:8000/auth/reddit/callback
# Reddit requires a descriptive User-Agent identifying your app + a contact username
REDDIT_USER_AGENT=pop-app/0.1 (by /u/your_reddit_username)
REDDIT_SCOPES=identity mysubreddits

FRONTEND_URL=http://localhost:5173
ENVIRONMENT=development

# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_SECRET_KEY=

# Optional: the general "how echo chambers work" article you want pinned at
# the top of the dashboard. Leave blank to hide the banner.
GENERAL_ARTICLE_TITLE=
GENERAL_ARTICLE_URL=
